# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.env

# Frontend dependencies
frontend/node_modules/

# Backend static (copied from frontend dist at package time)
backend/static/

# Release archives
dist/*.zip
dist/*.tar.gz
dist/*.dmg
dist/*.exe

# Runtime data
*.db
*.db-shm
*.db-wal
*.sqlite

# claude-flow sessions and runtime state (whole dirs - specific files above
# were a losing whack-a-mole against new runtime files added each session)
.claude-flow/*
!.claude-flow/agents/
!.claude-flow/data/
!.claude-flow/plugins/
backend/.claude-flow/
frontend/.claude-flow/*
!frontend/.claude-flow/data/
frontend/.claude-flow/metrics/

# claude-flow config files (auto-generated)
.claude-flow/.gitignore
.claude-flow/CAPABILITIES.md
.claude-flow/config.yaml
frontend/claude-flow.config.json
frontend/agentdb.rvf
frontend/agentdb.rvf.lock
frontend/data/

# Claude local config
.claude/
.mcp.json
.swarm/

# Build outputs
build/
dist/Director\ Assistant.app/
dist/DirectorAssistant/
dist/DirectorAssistant*/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
.claude-flow/plugins/node_modules/

# Build/analysis output directories (not source)
dist/
graphify-out/

# TypeScript incremental build cache
frontend/tsconfig.tsbuildinfo

# agentdb runtime artifacts
agentdb.rvf.idmap.json
